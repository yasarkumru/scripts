#!/usr/bin/env python3
# uupd-logs - readable uupd status
#
#   uupd-logs                     summary of the last 12h
#   uupd-logs --since "24 hours ago"
#   uupd-logs --debug             every line, JSON condensed (per-package detail)
#   uupd-logs --all               raw journal output, no filtering

import argparse
import json
import re
import subprocess
import sys
import time
from datetime import datetime
from signal import SIG_DFL, SIGPIPE, signal

# Let SIGPIPE kill us quietly (e.g. `uupd-logs --debug | less` + quit).
signal(SIGPIPE, SIG_DFL)

UNITS = ["-u", "uupd.service", "-u", "uupd-manual.service"]
ANSI = re.compile(r"\x1b\[[0-9;]*m")
BOX_RE = re.compile(r"Upgrading ([A-Za-z0-9_.-]+)\.\.\.")
FAIL_RE = re.compile(r"fatal:|Error: Fetching|Failed to download|CONNECT tunnel failed", re.I)
QUIET_LEVELS = {"", "INFO", "NOTICE", "DEBUG"}

# Per-distrobox result detection, from the package manager's own output.
UPGRADED_RES = [
    re.compile(r"^(\d+) upgraded, "),                    # apt
    re.compile(r"^\s*Upgrading:\s+(\d+) packages?"),    # dnf5
    re.compile(r"^Packages? \((\d+)\)"),                # pacman
    re.compile(r"^\(\d+/(\d+)\) (Upgrading|Replacing) "), # apk
]
UPTODATE_RE = re.compile(
    r"^(Nothing to do\.|there is nothing to do|0 upgraded, |OK: .* in \d+ packages)", re.I)


def strip(s):
    return ANSI.sub("", s).strip()


# --------------------------------------------------------------------------- input

def journal(since):
    """Yield (epoch_seconds, message) for every uupd journal entry."""
    cmd = ["journalctl", *UNITS, "--no-pager", "-o", "json", "--since", since,
           "--output-fields=MESSAGE,__REALTIME_TIMESTAMP"]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    try:
        for line in p.stdout:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            msg = e.get("MESSAGE") or ""
            if isinstance(msg, list):  # non-UTF-8 payload comes as a byte array
                msg = bytes(msg).decode("utf-8", "replace")
            yield int(e.get("__REALTIME_TIMESTAMP", 0)) / 1e6, msg
    finally:
        p.terminate()
        p.wait()


def parse(msg):
    """uupd emits one JSON object per line; anything else is plain text (None)."""
    if not msg.startswith("{"):
        return None
    try:
        o = json.loads(msg)
    except ValueError:
        return None
    return o if isinstance(o, dict) else None


# -------------------------------------------------------------------------- render

def is_cmd_output(o):
    """Per-line stdout of a module's command. Chatty; errors are never considered chatter."""
    return o.get("msg") == "Command output" and o.get("level", "").upper() in QUIET_LEVELS


def render(o):
    """One uupd JSON event -> one readable line."""
    lvl = o.get("level", "")
    msg = strip(o.get("msg", ""))
    out = o.get("output")
    out = strip(out) if isinstance(out, str) else ""
    mod = o.get("module", "")

    if o.get("msg") == "Command output":
        return f"{lvl}: {mod}: {out}" if mod else f"{lvl}: {out}"
    if o.get("title") or o.get("description"):
        detail = out if out and out != msg else msg
        return f"{lvl}: {o.get('title', '')} ({o.get('description', '')}): {detail}"
    if mod:
        if out and out != msg:
            return f"{lvl}: {mod}: {msg}: {out}"
        cli = o.get("cli")
        if isinstance(cli, list):
            cli = " ".join(cli)
        return f"{lvl}: {mod}: {msg}" + (f" [{cli}]" if cli else "")
    return f"{lvl}: {msg}"


def fmt_dur(secs):
    secs = int(secs)
    if secs < 60:
        return f"{secs}s"
    m, s = divmod(secs, 60)
    if m < 60:
        return f"{m}m {s}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h {m}m"


def fmt_t(ts):
    return datetime.fromtimestamp(ts).strftime("%H:%M:%S")


def fmt_dt(ts):
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")


# --------------------------------------------------------------------------- modes

def do_all(since):
    subprocess.run(["journalctl", *UNITS, "--since", since, "--no-pager", "-o", "cat"])


def do_debug(since):
    any_ = False
    for _, msg in journal(since):
        any_ = True
        o = parse(msg)
        print(render(o) if o is not None else msg)
    if not any_:
        print(f"No uupd logs since {since}.")


def uupd_running():
    """True while uupd (oneshot -> 'activating') or uupd-manual is running."""
    p = subprocess.run(["systemctl", "is-active", "uupd.service", "uupd-manual.service"],
                       capture_output=True, text=True)
    return any(s in ("active", "activating") for s in p.stdout.split())


def fmt_box(b):
    n = b["upgraded"]
    if b.get("running"):
        res = "updating..." + (f" ({n} package{'s' if n != 1 else ''})" if n else "")
    elif n:
        res = f"updated, {n} package{'s' if n != 1 else ''}"
    elif b["uptodate"] or n == 0:
        res = "up to date"
    else:
        res = "done"
    if b["failed"]:
        res += " (errors, see hints)"
    return f"    - {b['name']}: {res}"


def do_summary(since):
    lines, hints = [], []      # lines: str, or a dict for a distrobox (filled in as output arrives)
    box = None
    started = None

    for ts, msg in journal(since):
        o = parse(msg)
        if o is None:
            if "Starting uupd" in msg:
                started = ts
                lines.append(f"[{fmt_dt(ts)}] {msg}")
            elif "Finished uupd" in msg:
                lines.append(f"[{fmt_dt(ts)}] {msg}")
                if started is not None:
                    lines.append(f"  └─ took {fmt_dur(ts - started)} ({fmt_t(started)} → {fmt_t(ts)})")
                started = None
            elif "Deactivated successfully" in msg or "Failed with result" in msg:
                lines.append(f"[{fmt_dt(ts)}] {msg}")
            continue

        out = o.get("output")
        text = strip(out if is_cmd_output(o) and isinstance(out, str) else o.get("msg", ""))
        if FAIL_RE.search(text):
            hints.append(text)
            if box is not None:
                box["failed"] = True

        if is_cmd_output(o):
            if o.get("module") == "distrobox":
                if m := BOX_RE.search(text):
                    box = {"name": m.group(1), "upgraded": None, "uptodate": False, "failed": False}
                    lines.append(box)
                elif box is not None:
                    for r in UPGRADED_RES:
                        if m := r.search(text):
                            box["upgraded"] = int(m.group(1))
                    if UPTODATE_RE.search(text):
                        box["uptodate"] = True
            continue
        if o.get("module") != "distrobox" or o.get("status") == "finished":
            box = None
        if o.get("level") == "DEBUG":
            continue
        lines.append(render(o))

    if not lines and not hints:
        print(f"No uupd logs since {since}.")
        return

    running = uupd_running()
    if running and box is not None:
        box["running"] = True  # its result lines may not have arrived yet

    print(f"=== uupd status (since {since}) ===\n")
    for ln in lines:
        print(fmt_box(ln) if isinstance(ln, dict) else ln)
    if running:
        since_s = f", started {fmt_t(started)}, {fmt_dur(time.time() - started)} ago" if started else ""
        print(f"  └─ RUNNING NOW{since_s}")
    elif started is not None:
        print(f"  └─ no finish in window (started {fmt_t(started)})")

    if hints:
        print("\n--- Failure hints ---")
        for h in dict.fromkeys(hints):
            print(f"  {h}")

    print("\nTip: uupd-logs --debug | less (per-package detail),  uupd-logs --all | less (raw)")


def main():
    ap = argparse.ArgumentParser(description="Readable uupd status")
    ap.add_argument("--since", default="12 hours ago")
    ap.add_argument("--all", action="store_true", help="raw journal output")
    ap.add_argument("--debug", action="store_true", help="include DEBUG lines")
    args = ap.parse_args()

    if args.all:
        do_all(args.since)
    elif args.debug:
        do_debug(args.since)
    else:
        do_summary(args.since)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
