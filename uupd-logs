#!/usr/bin/env python3
# uupd-logs - readable uupd status for the last 12 hours
#
#   uupd-logs                    summary (default, last 12h)
#   uupd-logs --since "24 hours ago"
#   uupd-logs --all              raw journal output, no filtering
#   uupd-logs --debug            include DEBUG lines (per-package spam)

import argparse
import json
import re
import subprocess
import sys
from signal import SIG_DFL, SIGPIPE, signal

# Let SIGPIPE kill us quietly (e.g. `uupd-logs --all | less` + quit).
signal(SIGPIPE, SIG_DFL)

ANSI = re.compile(r"\x1b\[[0-9;]*m")
BOX_RE = re.compile(r"Upgrading ([A-Za-z0-9_.-]+)\.\.\.")
FAIL_RE = re.compile(r"fatal:|Error: Fetching|Failed to download|CONNECT tunnel failed", re.I)


def get_logs(since):
    p = subprocess.run(
        ["journalctl", "-u", "uupd.service", "-u", "uupd-manual.service",
         "--since", since, "--no-pager", "-o", "cat"],
        capture_output=True, text=True,
    )
    return (p.stdout or "") + (p.stderr or "")


def main():
    ap = argparse.ArgumentParser(description="Readable uupd status")
    ap.add_argument("--since", default="12 hours ago")
    ap.add_argument("--all", action="store_true", help="raw journal output")
    ap.add_argument("--debug", action="store_true", help="include DEBUG lines")
    args = ap.parse_args()

    raw = get_logs(args.since)
    if not raw.strip():
        print(f"No uupd logs since {args.since}.")
        return

    if args.all:
        print(raw, end="" if raw.endswith("\n") else "\n")
        return

    if args.debug:
        for line in raw.splitlines():
            line = line.strip()
            if line.startswith("{"):
                try:
                    o = json.loads(line)
                    print(f"{o.get('level', '')}: {ANSI.sub('', o.get('msg', '')).strip()}")
                    continue
                except ValueError:
                    pass
            print(line)
        return

    summary = []
    boxes = set()
    hints = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        if not line.startswith("{"):
            if ("Starting uupd" in line or "Finished uupd" in line
                    or "Deactivated successfully" in line):
                summary.append(line)
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        lvl = o.get("level", "")
        msg = ANSI.sub("", o.get("msg", "")).strip()
        if lvl == "DEBUG":
            m = BOX_RE.search(msg)
            if m:
                boxes.add(m.group(1))
            if FAIL_RE.search(msg):
                hints.append(msg)
            continue
        title, desc, mod = o.get("title", ""), o.get("description", ""), o.get("module", "")
        if title or desc:
            summary.append(f"{lvl}: {title} ({desc}): {msg}")
        elif mod:
            cli = o.get("cli", "")
            if isinstance(cli, list):
                cli = " ".join(cli)
            summary.append(f"{lvl}: {mod}: {msg} [{cli}]")
        else:
            summary.append(f"{lvl}: {msg}")

    print(f"=== uupd status (since {args.since}) ===\n")
    for s in summary:
        print(s)

    if boxes:
        print(f"\n--- Distroboxes attempted ({len(boxes)}) ---")
        for b in sorted(boxes):
            print(f"  - {b}")

    if hints:
        print("\n--- Failure hints (from DEBUG) ---")
        for h in dict.fromkeys(hints):
            print(f"  {h}")

    print("\nTip: uupd-logs --all | less  (raw),  uupd-logs --debug | less  (per-package detail)")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
