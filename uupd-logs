#!/usr/bin/env python3
# uupd-logs - readable uupd status for the last 12 hours
#
#   uupd-logs                    summary (default, last 12h)
#   uupd-logs --since "24 hours ago"
#   uupd-logs --all              raw journal output, no filtering
#   uupd-logs --debug            include DEBUG lines (per-package spam)
#   uupd-logs --follow           live uupd messages, cleaned (no timestamps/JSON)

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime
from signal import SIG_DFL, SIGPIPE, signal

# Let SIGPIPE kill us quietly (e.g. `uupd-logs --all | less` + quit).
signal(SIGPIPE, SIG_DFL)

ANSI = re.compile(r"\x1b\[[0-9;]*m")
BOX_RE = re.compile(r"Upgrading ([A-Za-z0-9_.-]+)\.\.\.")
FAIL_RE = re.compile(r"fatal:|Error: Fetching|Failed to download|CONNECT tunnel failed", re.I)
CMD_NOISE_LEVELS = {"", "INFO", "NOTICE", "DEBUG"}


def is_cmd_output_noise(o):
    """uupd 'Command output' spam (per-chunk fetch lines); errors stay visible."""
    return (o.get("msg") == "Command output"
            and o.get("level", "").upper() in CMD_NOISE_LEVELS)


def get_logs(since):
    p = subprocess.run(
        ["journalctl", "-u", "uupd.service", "-u", "uupd-manual.service",
         "--since", since, "--no-pager", "-o", "cat"],
        capture_output=True, text=True,
    )
    return (p.stdout or "") + (p.stderr or "")


def get_run_times(since):
    """(start_epoch, end_epoch|None) per run, pairing Starting->Finished in order."""
    p = subprocess.run(
        ["journalctl", "-u", "uupd.service", "-u", "uupd-manual.service",
         "--since", since, "--no-pager", "-o", "short-unix"],
        capture_output=True, text=True,
    )
    starts, ends = [], []
    for line in (p.stdout or "").splitlines():
        parts = line.split(None, 1)
        if not parts:
            continue
        try:
            ts = float(parts[0])
        except ValueError:
            continue
        if "Starting uupd" in line:
            starts.append(ts)
        elif "Finished uupd" in line:
            ends.append(ts)
    runs, ei = [], 0
    for s in starts:
        e = None
        while ei < len(ends) and ends[ei] < s:
            ei += 1
        if ei < len(ends):
            e = ends[ei]
            ei += 1
        runs.append((s, e))
    return runs


def fmt_dur(secs):
    secs = int(secs)
    if secs < 60:
        return f"{secs}s"
    m, s = divmod(secs, 60)
    if m < 60:
        return f"{m}m {s}s" if s else f"{m}m"
    h, m = divmod(m, 60)
    return f"{h}h {m}m"


def fmt_t(ts):
    return datetime.fromtimestamp(ts).strftime("%H:%M:%S")


def clean_msg(msg):
    """Journal message -> readable line; None for multi-line JSON blobs."""
    if msg.startswith("{"):
        try:
            o = json.loads(msg)
        except ValueError:
            return None
        if is_cmd_output_noise(o):
            return None
        msg = o.get("msg", "")
    return ANSI.sub("", msg).strip() or None


def follow():
    """Stream uupd journal messages live, without timestamps/JSON noise."""
    p = subprocess.Popen(
        ["journalctl", "-u", "uupd.service", "-u", "uupd-manual.service",
         "-f", "--no-pager", "-o", "short-unix"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )
    try:
        for line in p.stdout:
            line = line.rstrip("\n")
            parts = line.split(None, 1)
            try:
                float(parts[0])
            except ValueError:
                continue  # continuation of a multi-line entry
            msg = parts[1] if len(parts) > 1 else ""
            if "]: " in msg:
                msg = msg.partition("]: ")[2]  # strip "host unit[pid]: "
            out = clean_msg(msg)
            if out:
                print(out, flush=True)
    finally:
        p.terminate()
        p.wait()


def format_entry(o):
    """One non-DEBUG journal JSON entry -> summary line (None = drop)."""
    lvl = o.get("level", "")
    msg = ANSI.sub("", o.get("msg", "")).strip()
    if is_cmd_output_noise(o):
        return None
    title, desc, mod = o.get("title", ""), o.get("description", ""), o.get("module", "")
    if title or desc:
        return f"{lvl}: {title} ({desc}): {msg}"
    if mod:
        cli = o.get("cli", "")
        if isinstance(cli, list):
            cli = " ".join(cli)
        return f"{lvl}: {mod}: {msg} [{cli}]"
    return f"{lvl}: {msg}"


def print_debug_line(line):
    if line.startswith("{"):
        try:
            o = json.loads(line)
            print(f"{o.get('level', '')}: {ANSI.sub('', o.get('msg', '')).strip()}")
            return
        except ValueError:
            pass
    print(line)


def main():
    ap = argparse.ArgumentParser(description="Readable uupd status")
    ap.add_argument("--since", default="12 hours ago")
    ap.add_argument("-f", "--follow", action="store_true",
                    help="live uupd messages, cleaned (no timestamps/JSON)")
    ap.add_argument("--all", action="store_true", help="raw journal output")
    ap.add_argument("--debug", action="store_true", help="include DEBUG lines")
    args = ap.parse_args()

    if args.follow:
        follow()
        return

    raw = get_logs(args.since)
    if not raw.strip():
        print(f"No uupd logs since {args.since}.")
        return

    if args.all:
        print(raw, end="" if raw.endswith("\n") else "\n")
        return

    if args.debug:
        for line in raw.splitlines():
            print_debug_line(line.strip())
        return

    summary = []
    boxes = set()
    hints = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        if not line.startswith("{"):
            if ("Starting uupd" in line or "Finished uupd" in line
                    or "Deactivated successfully" in line):
                summary.append(line)
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        lvl = o.get("level", "")
        msg = ANSI.sub("", o.get("msg", "")).strip()
        if lvl == "DEBUG":
            m = BOX_RE.search(msg)
            if m:
                boxes.add(m.group(1))
            if FAIL_RE.search(msg):
                hints.append(msg)
            continue
        entry = format_entry(o)
        if entry:
            summary.append(entry)

    print(f"=== uupd status (since {args.since}) ===\n")
    runs = get_run_times(args.since)
    run_i = 0
    for s in summary:
        print(s)
        if "Finished uupd.service" in s:
            if run_i < len(runs):
                st, en = runs[run_i]
                if en is not None:
                    print(f"  └─ took {fmt_dur(en - st)} ({fmt_t(st)} → {fmt_t(en)})")
                else:
                    print(f"  └─ no finish in window (started {fmt_t(st)})")
            run_i += 1
    # Runs that started but whose Finished line was filtered out of the summary
    # (can't happen currently, kept for safety) — nothing to do.

    if boxes:
        print(f"\n--- Distroboxes attempted ({len(boxes)}) ---")
        for b in sorted(boxes):
            print(f"  - {b}")

    if hints:
        print("\n--- Failure hints (from DEBUG) ---")
        for h in dict.fromkeys(hints):
            print(f"  {h}")

    print("\nTip: uupd-logs --follow (live),  uupd-logs --all | less  (raw),  uupd-logs --debug | less  (per-package detail)")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
